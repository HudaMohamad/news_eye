# ================================================
# SSTNews Backend — Environment Configuration Template
# ================================================
# Copy this file to .env and fill in your real values.
# This file IS safe to commit to version control.
# ================================================

# ----- Application -----
APP_ENV=development
APP_URL=http://localhost
APP_NAME=SSTNews

# ----- Database -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# ----- Upload URLs -----
# Base URL for uploaded images (no trailing slash)
UPLOAD_BASE_URL=http://localhost/news/backend/upload

# ----- CORS -----
# Comma-separated list of allowed origins (no trailing slash)
CORS_ALLOWED_ORIGIN=http://localhost:4200